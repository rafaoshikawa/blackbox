---
// src/components/Home.astro

import Brands from "./Brands.astro";
import ColecaoCards from "./colecaoCards.astro";
import Services from "../components/Services.astro";
---

<section class="hero">
  <div class="hero-img">
    <div class="container-hero mg-bottom container">
      <h1>
        Onde à performance <br />
        <span class="gradient-gold" style="line-height: 1.3;"
          >encontra elegância</span
        >

        <p class="text-1">Transforme cada viagem numa experiência única.</p>
      </h1>

      <div class="container-btn">
        <a
          class="btn-2"
          href="https://whatsa.me/351924478766/?t=Ol%C3%A1!%20Gostava%20de%20pedir%20uma%20proposta,%20podem%20ajudar?"
          >Pedir proposta</a
        >
        <a class="btn-3" href="/viaturas">Ver viaturas</a>
      </div>
    </div>
  </div>
</section>
<section class="products container">
  <div class="container-hero container">
    <p class="text-2">As Nossas Viaturas</p>
    <p class="text-1" id="viaturas">
      Conheça a nossa seleção de viaturas disponíveis para si
    </p>
  </div>
  <div class="card-grid-home">
    <ColecaoCards limit={6} />
    <div class="btn-3-container">
      <a class="btn-3" href="/viaturas">Ver mais</a>
    </div>
  </div>

  <div class="slider-dots"></div>
</section>

<Brands />

<section class="about bg-color" id="sobre">
  <div class="container-about">
    <div class="container-flex">
      <div class="container-text">
        <div class="card-container-text">
          <div class="container-header-text">
            <h2 class="text-h2">BLACKBOX</h2>
            <p class="text-3">A nossa História</p>
          </div>

          <p class="text-p">
            Somos um stand automóvel especializado na venda de viaturas de
            qualidade, oferecendo opções que vão desde modelos citadinos até
            automóveis familiares e desportivos. O nosso objetivo é garantir que
            cada cliente encontre a viatura ideal com confiança, segurança e
            total transparência.
          </p>
          <p class="text-p">
            Trabalhamos com foco na excelência do atendimento e na satisfação do
            cliente em todas as etapas do processo. Desde a escolha do veículo
            até à entrega, proporcionamos uma experiência única, profissional e
            adaptada às necessidades de cada cliente.
          </p>
        </div>
      </div>

      <div class="container-baloons">
        <div class="services-baloon">
          <img src="/images/award.svg" alt="Selo de qualidade" />
          <h4>Veículos de qualidade</h4>
          <p>
            Trabalhamos apenas com veículos inspecionados, garantindo qualidade,
            segurança e excelente estado de conservação para cada cliente.
          </p>
        </div>

        <div class="services-baloon">
          <img src="/images/users.svg" alt="Atendimento personalizado" />
          <h4>Atendimento Personalizado</h4>
          <p>
            Auxiliamos em todo o processo de escolha do carro ideal, com
            atendimento próximo, rápido e focado nas suas necessidades.
          </p>
        </div>

        <div class="services-baloon">
          <img src="/images/clock.svg" alt="Entrega no prazo" />
          <h4>Entrega Segura e Rápida</h4>
          <p>
            Garantimos uma compra simples e transparente, com toda a
            documentação tratada de forma rápida para que receba o seu veículo
            sem complicações.
          </p>
        </div>

        <div class="services-baloon">
          <img src="/images/palette.svg" alt="Design exclusivo" />
          <h4>Variedade de modelos</h4>
          <p>
            Desde carros citadinos económicos até SUVs e desportivos, temos
            opções para todos os estilos de condução.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
