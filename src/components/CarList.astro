---
import { supabase } from "../lib/supabase.js";
import CarCard from "./CarCard.astro";

const { data: cars, error } = await supabase
  .from("cars")
  .select("*")
  .order("id", { ascending: false });

const carsToShow = cars ?? [];

if (error) {
  console.error(error);
}
---

<div class="card-grid">
  {carsToShow.map((car) => <CarCard car={car} />)}
</div>
