---
const { car } = Astro.props;
---

<div
  class="car-card"
  data-status={car.status}
  data-images={JSON.stringify(car.images)}
  data-brand={car.brand}
  data-model={car.model}
  data-price={car.price}
  data-year={car.year}
  data-fuel={car.fuel}
  data-km={car.km}
  data-caixa={car.caixa}
  data-segmento={car.segmento}
  data-cilindrada={car.cilindrada}
  data-potencia={car.potencia}
>
  <!-- BADGE STATUS -->
  {car.status && car.status !== "disponivel" && (
    <div class={`car-status ${car.status}`}>
      {car.status === "vendido" ? "VENDIDO" : "RESERVADO"}
    </div>
  )}

  <div class="car-image">
    <img src={car.image} alt={car.model} />
  </div>

  <div class="car-info">
    <div class="car-meta">
      <div class="meta-item">
        <span>{car.year}</span>
      </div>

      <div class="meta-item">
        <span>{car.fuel}</span>
      </div>

      <div class="meta-item">
        <span>{car.km}</span>
      </div>
    </div>

    <h2 class="brand">{car.brand}</h2>
    <p class="model">{car.model}</p>

    <div class="price">
      <span>Preço</span>
      <strong>{car.price}</strong>
    </div>
  </div>
</div>