---
import "../styles/header.css";
---

<header class="header">
  <!-- Logo -->
  <div class="header-title">
    <a href="/" class="logo"> <img src="./images/blackboxlogo.png" alt="BlackBox Logo"> </a>
  </div>

  <!-- Ícone Menu Mobile -->
  <div class="menu-icon">
    <i class="bx bx-menu" id="menu-icon"></i>
  </div>

  <!-- Navegação -->
  <nav class="navbar">
    <!-- Crachás -->
    <div class="dropdown">
      <a href="/colecao">Coleção</a>
    </div>

    <!-- Credenciais -->
    <div class="dropdown">
      <a href="/#sobre">Sobre</a>
    </div>

    <!-- Brindes -->
    <div class="dropdown">
      <a href="/#contato">Contacto</a>
    </div>

    <!-- CTA -->
    <a
      href="https://whatsa.me/5511963352624/?t=Ol%C3%A1!%20Vim%20pelo%20site%20e%20gostaria%20de%20fazer%20um%20or%C3%A7amento%20%F0%9F%98%8A"
      target="_blank"
      class="btn-2"
      style="color: black;
      padding: 8px 16px;"
    >
      Fazer Orçamento
    </a>
  </nav>

  <!-- Fundo do Menu Mobile -->
  <div class="nav-bg"></div>

  <!-- Script -->
  <script type="module" src="/js/script.js"></script>
</header>
