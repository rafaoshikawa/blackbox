---
import { supabase } from "../../lib/supabase.js";
import "../../styles/admin-login.css";
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <title>Login Admin</title>
    <style>
      /* ── Loader overlay ── */
      #loader-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 14px;
      }
      #loader-overlay.active {
        display: flex;
      }
      .loader-spinner {
        width: 44px;
        height: 44px;
        border: 4px solid #333;
        border-top-color: #1e3a8a;
        border-radius: 50%;
        animation: spin 0.75s linear infinite;
      }
      .loader-label {
        color: #ccc;
        font-size: 13px;
        letter-spacing: 0.04em;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body class="login-body">
    <!-- LOADER -->
    <div id="loader-overlay">
      <div class="loader-spinner"></div>
      <span class="loader-label">A entrar...</span>
    </div>

    <div class="login-container">
      <h1 class="login-title">Login</h1>
      <form id="login-form" class="login-form" accept-charset="utf-8">
        <input
          class="login-input"
          name="email"
          type="email"
          placeholder="Email"
          required
        />
        <input
          class="login-input"
          name="password"
          type="password"
          placeholder="Password"
          required
        />
        <button class="login-button" type="submit">Entrar</button>
      </form>
      <p id="error" class="login-error"></p>
    </div>

    <script type="module">
      import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm";
      const supabase = createClient(
        "https://ziylcoupschcusnlsblu.supabase.co",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppeWxjb3Vwc2NoY3VzbmxzYmx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyMDAwMjksImV4cCI6MjA5NTc3NjAyOX0.6HdFwkPcwxUTlbKvhr3EoSI1qz3U9e3fCeITLr8eVmY",
      );

      const form = document.getElementById("login-form");
      const errorMsg = document.getElementById("error");
      const loaderOverlay = document.getElementById("loader-overlay");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.textContent = "";
        loaderOverlay.classList.add("active");

        const formData = new FormData(form);
        const email = formData.get("email");
        const password = formData.get("password");

        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password,
        });

        if (error) {
          loaderOverlay.classList.remove("active");
          errorMsg.textContent = error.message;
          return;
        }

        window.location.href = "/admin/dashboard";
      });
    </script>
  </body>
</html>
