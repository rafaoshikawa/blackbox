---
import { supabase } from "../../lib/supabase.js";
import "../../styles/admin-dashboard.css";

const { data: cars } = await supabase
  .from("cars")
  .select("*")
  .order("id", { ascending: true });

const safeCars = cars ?? [];
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <title>Dashboard</title>
  </head>

  <body>
    <div class="dashboard-header">
      <div>
        <h1>Dashboard</h1>
        <button id="logout" class="logout-btn">Logout</button>
      </div>

      <button id="delete-selected" class="delete-selected">
        🗑 Apagar Selecionados
      </button>
    </div>

    <div class="cars-grid">
      {
        safeCars.map((car) => (
          <div class="car-card" data-id={car.id}>
            <input type="checkbox" class="checkbox" />

            <img src={car.image} class="car-image" />

            <div class="car-content">
              <h3>{car.brand}</h3>
              <p>{car.model}</p>

              <div class="car-meta">
                <span>{car.year}</span>
                <span>{car.price}</span>
              </div>

              <div class="car-actions">
                <button class="edit-btn">✏ Editar</button>
                <button class="delete-btn">🗑 Apagar</button>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <button class="fab" id="open-modal">+</button>

    <!-- MODAL -->
    <div class="modal" id="modal">
      <div class="modal-content">
        <button class="close-modal" id="close-modal">×</button>

        <h2>Carro</h2>

        <label>Nome</label>
        <input id="brand" />

        <label>Descrição</label>
        <input id="model" />

        <label>Ano</label>
        <input id="year" />

        <label>Preço</label>
        <input id="price" />

        <label>Km</label>
        <input id="km" />

        <label>Combustível</label>
        <input id="fuel" />

        <label>Caixa</label>
        <input id="caixa" />

        <label>Segmento</label>
        <input id="segmento" />

        <label>Cilindrada</label>
        <input id="cilindrada" />

        <label>Potencia</label>
        <input id="potencia" />

        <label>Status</label>
        <input id="status" placeholder="vendido/reservado/disponivel" />

        <label>Imagem de Capa (1)</label>
        <input type="file" id="coverImage" accept="image/*" />

        <label>Outras Imagens (max 14)</label>
        <input type="file" id="galleryImages" accept="image/*" multiple />

        <div id="existing-images-box" style="display:none; margin-top:10px;">
          <h4>Imagens atuais</h4>
          <div id="existing-images"></div>
        </div>

        <div id="new-images-box" style="margin-top:10px;">
          <h4>Imagens adicionadas</h4>
          <div id="new-images"></div>
        </div>

        <button id="save-car">Guardar</button>
      </div>
    </div>

    <!-- CONFIRM DELETE -->
    <div id="confirm-overlay" class="confirm-overlay">
      <div class="confirm-box">
        <p>Tens certeza que queres remover este item?</p>

        <div class="confirm-actions">
          <button id="confirm-no">Cancelar</button>
          <button id="confirm-yes">Apagar</button>
        </div>
      </div>
    </div>

    <!-- IMAGE PREVIEW -->
    <div id="image-preview" class="image-preview">
      <div class="image-preview-inner">
        <img id="image-preview-img" />
        <button id="close-preview">×</button>
      </div>
    </div>

<script type="module">
  import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm";

  const supabase = createClient(
    "https://ziylcoupschcusnlsblu.supabase.co",
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppeWxjb3Vwc2NoY3VzbmxzYmx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyMDAwMjksImV4cCI6MjA5NTc3NjAyOX0.6HdFwkPcwxUTlbKvhr3EoSI1qz3U9e3fCeITLr8eVmY",
  );

  let editingId = null;
  let deleteId = null;
  let deleteMode = null;

  let currentImages = [];
  let removedImages = [];
  let newSelectedFiles = [];
  let coverImageFile = null;

  const modal = document.getElementById("modal");
  const closeModalBtn = document.getElementById("close-modal");

  const confirmOverlay = document.getElementById("confirm-overlay");
  const confirmYes = document.getElementById("confirm-yes");
  const confirmNo = document.getElementById("confirm-no");

  const coverImage = document.getElementById("coverImage");
  const galleryImages = document.getElementById("galleryImages");

  const existingBox = document.getElementById("existing-images-box");
  const existingImagesEl = document.getElementById("existing-images");

  const newBox = document.getElementById("new-images-box");
  const newImagesEl = document.getElementById("new-images");

  const preview = document.getElementById("image-preview");
  const previewImg = document.getElementById("image-preview-img");
  const closePreview = document.getElementById("close-preview");

  const deleteSelectedBtn = document.getElementById("delete-selected");

  const fields = {
    brand: document.getElementById("brand"),
    model: document.getElementById("model"),
    year: document.getElementById("year"),
    price: document.getElementById("price"),
    km: document.getElementById("km"),
    fuel: document.getElementById("fuel"),
    caixa: document.getElementById("caixa"),
    segmento: document.getElementById("segmento"),
    cilindrada: document.getElementById("cilindrada"),
    potencia: document.getElementById("potencia"),
    status: document.getElementById("status"),
  };

  function clearForm() {
    Object.values(fields).forEach((f) => (f.value = ""));
    coverImage.value = "";
    galleryImages.value = "";

    currentImages = [];
    removedImages = [];
    newSelectedFiles = [];
    coverImageFile = null;

    existingImagesEl.innerHTML = "";
    newImagesEl.innerHTML = "";

    existingBox.style.display = "none";
    newBox.style.display = "none";
  }

  function getFileName(url) {
    return url.split("?")[0].split("/").pop();
  }

  function openPreview(url) {
    previewImg.src = url;
    preview.classList.add("active");
  }

  closePreview.onclick = () => preview.classList.remove("active");

  function uploadFile(file) {
    return new Promise(async (resolve, reject) => {
      const path = `${Date.now()}-${file.name}`;

      const { error } = await supabase.storage
        .from("cars")
        .upload(path, file);

      if (error) return reject(error);

      const { data } = supabase.storage.from("cars").getPublicUrl(path);
      resolve(data.publicUrl);
    });
  }

  function renderNewImages() {
    newImagesEl.innerHTML = "";

    newSelectedFiles.forEach((file, index) => {
      const wrap = document.createElement("div");
      wrap.className = "img-row";

      const text = document.createElement("span");
      text.textContent = file.name;
      text.onclick = () => openPreview(URL.createObjectURL(file));

      const btn = document.createElement("button");
      btn.textContent = "X";

      btn.onclick = () => {
        newSelectedFiles.splice(index, 1);
        renderNewImages();
      };

      wrap.appendChild(text);
      wrap.appendChild(btn);
      newImagesEl.appendChild(wrap);
    });

    newBox.style.display = newSelectedFiles.length ? "block" : "none";
  }

  function renderExistingImages() {
    existingImagesEl.innerHTML = "";

    const all = [...currentImages];

    all.forEach((img) => {
      const wrap = document.createElement("div");
      wrap.className = "img-row";

      const text = document.createElement("span");
      text.textContent = getFileName(img);
      text.onclick = () => openPreview(img);

      const btn = document.createElement("button");
      btn.textContent = "X";

      btn.onclick = () => {
        removedImages.push(img);
        currentImages = currentImages.filter((i) => i !== img);
        renderExistingImages();
      };

      wrap.appendChild(text);
      wrap.appendChild(btn);
      existingImagesEl.appendChild(wrap);
    });

    existingBox.style.display = all.length ? "block" : "none";
  }

  function openModal() {
    document.querySelectorAll(".checkbox").forEach((c) => (c.checked = false));
    modal.classList.add("active");
  }

  function closeModal() {
    modal.classList.remove("active");
    clearForm();
  }

  document.getElementById("open-modal").onclick = () => {
    editingId = null;
    clearForm();
    openModal();
  };

  closeModalBtn.onclick = closeModal;

  modal.onclick = (e) => {
    if (e.target === modal) closeModal();
  };

  /* ==============================
     🔥 FIX PRINCIPAL AQUI
     - NÃO substitui mais arquivos
     - sempre adiciona
     ============================== */

  galleryImages.addEventListener("change", (e) => {
    const files = Array.from(e.target.files);

    const remaining = 14 - newSelectedFiles.length;
    const toAdd = files.slice(0, remaining);

    newSelectedFiles = [...newSelectedFiles, ...toAdd];

    renderNewImages();

    // permite re-adicionar mesmo o mesmo ficheiro
    galleryImages.value = "";
  });

  /* ==============================
     CAPA TAMBÉM ENTRA NA LISTA
     ============================== */

  coverImage.addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (!file) return;

    coverImageFile = file;

    const remaining = 14 - newSelectedFiles.length;
    if (remaining > 0) {
      newSelectedFiles.push(file);
    }

    renderNewImages();

    coverImage.value = "";
  });

  document.addEventListener("click", async (e) => {
    const card = e.target.closest(".car-card");
    if (!card) return;

    const id = card.dataset.id;

    if (e.target.classList.contains("edit-btn")) {
      const { data } = await supabase
        .from("cars")
        .select("*")
        .eq("id", id)
        .maybeSingle();

      if (!data) return;

      editingId = id;

      Object.keys(fields).forEach((k) => {
        fields[k].value = data[k] ?? "";
      });

      currentImages = data.images || [];
      removedImages = [];
      newSelectedFiles = [];
      coverImageFile = null;

      renderExistingImages();
      renderNewImages();
      openModal();
    }

    if (e.target.classList.contains("delete-btn")) {
      deleteId = id;
      deleteMode = "single";
      confirmOverlay.classList.add("active");
    }
  });

  document.getElementById("save-car").onclick = async () => {
    const payload = {};

    Object.keys(fields).forEach((k) => {
      payload[k] = fields[k].value;
    });

    let uploaded = [];

    if (coverImageFile) {
      uploaded.push(await uploadFile(coverImageFile));
    }

    if (newSelectedFiles.length) {
      const extra = await Promise.all(newSelectedFiles.map(uploadFile));
      uploaded.push(...extra);
    }

    payload.image = uploaded[0] || payload.image;

    payload.images = [
      ...currentImages.filter((i) => !removedImages.includes(i)),
      ...uploaded,
    ];

    if (editingId) {
      await supabase.from("cars").update(payload).eq("id", editingId);
    } else {
      await supabase.from("cars").insert([payload]);
    }

    location.reload();
  };

  confirmNo.onclick = () => confirmOverlay.classList.remove("active");

  confirmYes.onclick = async () => {
    if (deleteMode === "single") {
      await supabase.from("cars").delete().eq("id", deleteId);
    }

    location.reload();
  };

  deleteSelectedBtn.onclick = () => {
    document.querySelectorAll(".checkbox").forEach((c) => (c.checked = false));
  };

  document.getElementById("logout").onclick = async () => {
    await supabase.auth.signOut();
    location.href = "/admin";
  };
</script>
  </body>
</html>
