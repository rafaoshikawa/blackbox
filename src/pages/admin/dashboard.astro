---
import { supabase } from "../../lib/supabase.js";
import "../../styles/admin-dashboard.css";

const { data: cars } = await supabase
  .from("cars")
  .select("*")
  .order("id", { ascending: true });

const safeCars = cars ?? [];
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <title>Dashboard</title>
  </head>

  <body>
    <div id="auth-guard" style="display:none;">
      <div class="dashboard-header">
        <div class="dashboard-header-2">
          <h1>Dashboard</h1>
          <button id="logout" class="logout-btn">Logout</button>
        </div>
        <button id="delete-selected" class="delete-selected">
          🗑 Apagar Selecionados
        </button>
      </div>

      <div class="cars-grid">
        {
          safeCars.map((car) => (
            <div class="car-card" data-id={car.id}>
              <input type="checkbox" class="checkbox" />
              <img src={car.image} class="car-image" />
              <div class="car-content">
                <h3>{car.brand}</h3>
                <p>{car.model}</p>
                <div class="car-meta">
                  <span>{car.year}</span>
                  <span>{car.price}</span>
                </div>
                <div class="car-actions">
                  <button class="edit-btn">✏ Editar</button>
                  <button class="delete-btn">🗑 Apagar</button>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <button class="fab" id="open-modal">+</button>

      <!-- MODAL -->
      <div class="modal" id="modal">
        <div class="modal-content">
          <button class="close-modal" id="close-modal">×</button>

          <h2>Carro</h2>

          <label>Nome</label>
          <input id="brand" />

          <label>Descrição</label>
          <input id="model" />

          <label>Ano</label>
          <input id="year" />

          <label>Preço</label>
          <input id="price" />

          <label>Km</label>
          <input id="km" />

          <label>Combustível</label>
          <input id="fuel" />

          <label>Caixa</label>
          <input id="caixa" />

          <label>Segmento</label>
          <input id="segmento" />

          <label>Cilindrada</label>
          <input id="cilindrada" />

          <label>Potencia</label>
          <input id="potencia" />

          <label>Status</label>
          <input id="status" placeholder="vendido/reservado/disponivel" />

          <input
            type="file"
            id="galleryImages"
            accept="image/*"
            multiple
            style="display:none"
          />

          <div id="image-manager">
            <h4>Imagens · 1ª é a capa · arrasta ≡ para reordenar</h4>
            <div class="img-list" id="img-list"></div>
            <button class="add-image-btn" id="add-image-btn"
              >+ Adicionar Imagens</button
            >
          </div>

          <button id="save-car">Guardar</button>
        </div>
      </div>

      <!-- CONFIRM DELETE -->
      <div id="confirm-overlay" class="confirm-overlay">
        <div class="confirm-box">
          <p>Tens certeza que queres remover este item?</p>
          <div class="confirm-actions">
            <button id="confirm-no">Cancelar</button>
            <button id="confirm-yes">Apagar</button>
          </div>
        </div>
      </div>

      <!-- IMAGE PREVIEW fullscreen -->
      <div id="image-preview" class="image-preview">
        <div class="image-preview-inner">
          <img id="image-preview-img" />
          <button id="close-preview">×</button>
        </div>
      </div>
    </div>

    <script type="module">
      import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm";

      const supabase = createClient(
        "https://ziylcoupschcusnlsblu.supabase.co",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppeWxjb3Vwc2NoY3VzbmxzYmx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyMDAwMjksImV4cCI6MjA5NTc3NjAyOX0.6HdFwkPcwxUTlbKvhr3EoSI1qz3U9e3fCeITLr8eVmY",
      );

      // ── Auth guard ──────────────────────────────────────────────
      const authGuard = document.getElementById("auth-guard");
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = "/admin";
      } else {
        authGuard.style.display = "block";
      }

      // ── State ───────────────────────────────────────────────────
      let editingId = null;
      let deleteId = null;
      let deleteMode = null;
      let imageSlots = [];

      // ── DOM refs ────────────────────────────────────────────────
      const modal = document.getElementById("modal");
      const closeModalBtn = document.getElementById("close-modal");
      const confirmOverlay = document.getElementById("confirm-overlay");
      const confirmYes = document.getElementById("confirm-yes");
      const confirmNo = document.getElementById("confirm-no");
      const galleryInput = document.getElementById("galleryImages");
      const imgList = document.getElementById("img-list");
      const addImageBtn = document.getElementById("add-image-btn");
      const preview = document.getElementById("image-preview");
      const previewImg = document.getElementById("image-preview-img");
      const closePreview = document.getElementById("close-preview");
      const deleteSelectedBtn = document.getElementById("delete-selected");

      const fields = {
        brand: document.getElementById("brand"),
        model: document.getElementById("model"),
        year: document.getElementById("year"),
        price: document.getElementById("price"),
        km: document.getElementById("km"),
        fuel: document.getElementById("fuel"),
        caixa: document.getElementById("caixa"),
        segmento: document.getElementById("segmento"),
        cilindrada: document.getElementById("cilindrada"),
        potencia: document.getElementById("potencia"),
        status: document.getElementById("status"),
      };

      // ── Helpers ─────────────────────────────────────────────────
      function clearForm() {
        Object.values(fields).forEach((f) => (f.value = ""));
        galleryInput.value = "";
        imageSlots = [];
        renderList();
      }

      function openPreview(url) {
        previewImg.src = url;
        preview.classList.add("active");
      }

      closePreview.onclick = () => preview.classList.remove("active");

      function slotPreviewUrl(slot) {
        return slot.type === "existing"
          ? slot.url
          : URL.createObjectURL(slot.file);
      }

      function slotLabel(slot) {
        if (slot.type === "new") return slot.file.name;
        return decodeURIComponent(slot.url.split("?")[0].split("/").pop());
      }

      async function uploadFile(file) {
        const path = `${Date.now()}-${Math.random().toString(36).slice(2)}-${file.name}`;
        const { error } = await supabase.storage
          .from("cars")
          .upload(path, file);
        if (error) throw error;
        return supabase.storage.from("cars").getPublicUrl(path).data.publicUrl;
      }

      // ── List render ──────────────────────────────────────────────
      function renderList() {
        imgList.innerHTML = "";

        imageSlots.forEach((slot, index) => {
          const row = document.createElement("div");
          row.className = "img-row" + (index === 0 ? " is-cover" : "");
          row.draggable = true;
          row.dataset.index = index;

          const num = document.createElement("span");
          num.className = "row-num";
          num.textContent = index + 1;

          const handle = document.createElement("div");
          handle.className = "drag-handle";
          handle.innerHTML = "≡";
          handle.title = "Arrastar para reordenar";

          const name = document.createElement("span");
          name.className = "row-name";
          name.textContent = slotLabel(slot);
          name.title = "Ver em grande";
          name.onclick = (e) => {
            e.stopPropagation();
            openPreview(slotPreviewUrl(slot));
          };

          const removeBtn = document.createElement("button");
          removeBtn.className = "remove-row";
          removeBtn.innerHTML = "🗑";
          removeBtn.title = "Remover";
          removeBtn.onclick = (e) => {
            e.stopPropagation();
            imageSlots.splice(index, 1);
            renderList();
          };

          row.appendChild(num);
          row.appendChild(handle);
          row.appendChild(name);
          row.appendChild(removeBtn);

          handle.addEventListener("mousedown", () => {
            row.draggable = true;
          });
          row.addEventListener("dragstart", onDragStart);
          row.addEventListener("dragover", onDragOver);
          row.addEventListener("dragleave", onDragLeave);
          row.addEventListener("drop", onDrop);
          row.addEventListener("dragend", onDragEnd);

          imgList.appendChild(row);
        });
      }

      // ── Drag-and-drop ────────────────────────────────────────────
      let dragSrcIndex = null;

      function onDragStart(e) {
        dragSrcIndex = parseInt(this.dataset.index);
        this.classList.add("dragging");
        e.dataTransfer.effectAllowed = "move";
      }

      function onDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = "move";
        this.classList.add("drag-over");
      }

      function onDragLeave() {
        this.classList.remove("drag-over");
      }

      function onDrop(e) {
        e.preventDefault();
        this.classList.remove("drag-over");
        const targetIndex = parseInt(this.dataset.index);
        if (dragSrcIndex === null || dragSrcIndex === targetIndex) return;
        const moved = imageSlots.splice(dragSrcIndex, 1)[0];
        imageSlots.splice(targetIndex, 0, moved);
        renderList();
      }

      function onDragEnd() {
        dragSrcIndex = null;
        imgList.querySelectorAll(".img-row").forEach((el) => {
          el.classList.remove("dragging", "drag-over");
        });
      }

      // ── Adicionar imagens ────────────────────────────────────────
      addImageBtn.onclick = () => galleryInput.click();

      galleryInput.addEventListener("change", (e) => {
        const files = Array.from(e.target.files);
        const available = 15 - imageSlots.length;
        files.slice(0, available).forEach((file) => {
          imageSlots.push({ type: "new", file });
        });
        renderList();
        galleryInput.value = "";
      });

      // ── Modal open/close ─────────────────────────────────────────
      function openModal() {
        document
          .querySelectorAll(".checkbox")
          .forEach((c) => (c.checked = false));
        modal.classList.add("active");
      }

      function closeModal() {
        modal.classList.remove("active");
        clearForm();
      }

      document.getElementById("open-modal").onclick = () => {
        editingId = null;
        clearForm();
        openModal();
      };

      closeModalBtn.onclick = closeModal;
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };

      // ── Edit btn ─────────────────────────────────────────────────
      document.addEventListener("click", async (e) => {
        const card = e.target.closest(".car-card");
        if (!card) return;

        const id = card.dataset.id;

        if (e.target.classList.contains("edit-btn")) {
          const { data } = await supabase
            .from("cars")
            .select("*")
            .eq("id", id)
            .maybeSingle();

          if (!data) return;

          editingId = id;
          Object.keys(fields).forEach((k) => {
            fields[k].value = data[k] ?? "";
          });

          imageSlots = [];

          if (data.images && data.images.length > 0) {
            data.images.forEach((url) => {
              imageSlots.push({ type: "existing", url });
            });
            if (data.image) {
              const coverIdx = imageSlots.findIndex(
                (s) => s.url === data.image,
              );
              if (coverIdx > 0) {
                const [coverSlot] = imageSlots.splice(coverIdx, 1);
                imageSlots.unshift(coverSlot);
              } else if (coverIdx === -1) {
                imageSlots.unshift({ type: "existing", url: data.image });
              }
            }
          } else if (data.image) {
            imageSlots.push({ type: "existing", url: data.image });
          }

          renderList();
          openModal();
        }

        if (e.target.classList.contains("delete-btn")) {
          deleteId = id;
          deleteMode = "single";
          confirmOverlay.classList.add("active");
        }
      });

      // ── Save ─────────────────────────────────────────────────────
      document.getElementById("save-car").onclick = async () => {
        const payload = {};
        Object.keys(fields).forEach((k) => {
          payload[k] = fields[k].value;
        });

        const resolvedUrls = await Promise.all(
          imageSlots.map((slot) =>
            slot.type === "existing"
              ? Promise.resolve(slot.url)
              : uploadFile(slot.file),
          ),
        );

        payload.images = resolvedUrls;
        payload.image = resolvedUrls[0] ?? "";

        if (editingId) {
          await supabase.from("cars").update(payload).eq("id", editingId);
        } else {
          await supabase.from("cars").insert([payload]);
        }

        location.reload();
      };

      // ── Confirm delete ───────────────────────────────────────────
      confirmNo.onclick = () => confirmOverlay.classList.remove("active");
      confirmYes.onclick = async () => {
        if (deleteMode === "single") {
          await supabase.from("cars").delete().eq("id", deleteId);
        }
        location.reload();
      };

      deleteSelectedBtn.onclick = () => {
        document
          .querySelectorAll(".checkbox")
          .forEach((c) => (c.checked = false));
      };

      document.getElementById("logout").onclick = async () => {
        await supabase.auth.signOut();
        location.href = "/admin";
      };
    </script>
  </body>
</html>
