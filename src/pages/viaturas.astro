---
import HeadBase from "../components/HeadBase.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Services from "../components/Services.astro";


import CarList from "../components/CarList.astro";
import CarModal from "../components/CarModal.astro";

import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/cardgrid.css";
import "../styles/carCard.css";
import "../styles/brands.css";
import "../styles/colecao.css";
import "../styles/services.css";

---

<html lang="pt-BR">
  <HeadBase />

  <body>
    <div id="preloader">
      <div class="loader"></div>
    </div>
    <Header />
    <WhatsAppButton />
    <br />
    <br />
    <br />

    <!-- LISTA DE CARROS -->
    <section class="container" style="margin-top: 80px;">
      <div class="colecao-tittle">
        <h2 class="gradient-gold text-2">Encontre a Sua Viatura Ideal</h2>
        <h2 class="text-1">
          Conheça a nossa coleção de automóveis disponíveis para si
        </h2>
      </div>
      <div class="viaturas-search-container">
  <div class="search-box">
    <input
      type="text"
      id="viaturasSearchInput"
      class="search-input"
      placeholder="Pesquisar viaturas..."
    />
  </div>

  <div class="filter-actions">
    <button id="clearFilters">Limpar filtros</button>
    <button id="showAll">Mostrar todos</button>
  </div>
</div>
      <CarList />
      <div id="noResults" class="no-results" style="display:none;">
  <h3>Nenhuma viatura encontrada</h3>
  <p>Tenta outra pesquisa ou remove os filtros.</p>

  <a href="/viaturas" class="btn-no-results">Ver todas as viaturas</a>
</div>
    </section>
    <!-- MODAL GLOBAL (reutilizável em qualquer página) -->
    <CarModal />
    <Services/>

    <Footer />

    <!-- JS GLOBAL DO MODAL -->
    <script type="module" src="/js/script.js"></script>
    <script type="module" src="/js/carModal.js"></script>
    <script type="module" src="/js/slider-card.js"></script>
    <script type="module" src="/js/viaturas.js"></script>
  </body>
</html>
